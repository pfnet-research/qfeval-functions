#: ../../api/qfeval_functions.functions.ffill.rst:2
msgid "ffill"
msgstr ""

#: of qfeval_functions.functions.ffill.ffill:1
msgid "Forward fill missing values along the specified dimension."
msgstr "指定された次元に沿って欠損値を前方補完します。"

#: of qfeval_functions.functions.ffill.ffill:3
msgid ""
"This function propagates the last valid (non-NaN) values forward along "
"the specified dimension. For each NaN value, it is replaced with the most"
" recent valid value that appears before it along the dimension. If no "
"valid value exists before a NaN, it remains NaN."
msgstr "この関数は、指定された次元に沿って最後の有効な値（NaN でない値）を前方に伝播させます。各 NaN 値については、その次元に沿って直前に現れる最も新しい有効な値で置き換えられます。もし NaN 値の直前に有効な値が存在しない場合、その NaN 値は変更されずにそのまま保持されます。"

#: ../../api/qfeval_functions.functions.ffill.rst
msgid "Parameters"
msgstr "パラメータ"

#: of qfeval_functions.functions.ffill.ffill:9
msgid ""
"The input tensor containing values to be filled. May contain NaN values "
"that will be replaced."
msgstr "値を補完するための入力テンソル。NaN 値が含まれている場合があり、これらは指定された方法で置換されます。"

#: of qfeval_functions.functions.ffill.ffill:13
msgid ""
"The dimension along which to perform forward fill. Default is -1 (the "
"last dimension)."
msgstr "順方向フィルを実行する次元。デフォルトは -1 で、最後の次元を指定します。"

#: ../../api/qfeval_functions.functions.ffill.rst
msgid "Returns"
msgstr "戻り値"

#: of qfeval_functions.functions.ffill.ffill:17
msgid ""
"A tensor of the same shape as the input, with NaN values replaced by the "
"nearest preceding valid values where possible."
msgstr "入力テンソルと同じ形状で、NaN 値は可能な限り直前の有効な値で置き換えられます。"

#: ../../api/qfeval_functions.functions.ffill.rst
msgid "Return type"
msgstr "戻り値の型"

#: of qfeval_functions.functions.ffill.ffill:22
msgid "Example"
msgstr "使用例"

#: of qfeval_functions.functions.ffill.ffill:24
msgid ""
">>> # Simple 1D forward fill\n"
">>> x = torch.tensor([1.0, nan, nan, 4.0, 5.0])\n"
">>> QF.ffill(x)\n"
"tensor([1., 1., 1., 4., 5.])"
msgstr ">>> # 単純な 1 次元の前方埋め\n>>> x = torch.tensor([1.0, nan, nan, 4.0, 5.0])\n>>> QF.ffill(x)\ntensor([1., 1., 1., 4., 5.])"

#: of qfeval_functions.functions.ffill.ffill:29
msgid ""
">>> # 2D example with dim=1\n"
">>> x = torch.tensor([[nan, 2.0, nan, 4.0],\n"
"...                   [5.0, nan, nan, 8.0]])\n"
">>> QF.ffill(x, dim=1)\n"
"tensor([[nan, 2., 2., 4.],\n"
"        [5., 5., 5., 8.]])"
msgstr ">>> # dim=1 を指定した 2 次元の例\n>>> x = torch.tensor([[nan, 2.0, nan, 4.0],\n...                   [5.0, nan, nan, 8.0]])\n>>> QF.ffill(x, dim=1)\ntensor([[nan, 2., 2., 4.],\n        [5., 5., 5., 8.]])"

#: of qfeval_functions.functions.ffill.ffill:36
msgid ""
">>> # Forward fill along columns (dim=0)\n"
">>> x = torch.tensor([[1.0, nan, 3.0],\n"
"...                   [nan, 2.0, nan],\n"
"...                   [4.0, nan, nan]])\n"
">>> QF.ffill(x, dim=0)\n"
"tensor([[1., nan, 3.],\n"
"        [1., 2., 3.],\n"
"        [4., 2., 3.]])"
msgstr ">>> # 列方向の前方埋め（dim=0）\n>>> x = torch.tensor([[1.0, nan, 3.0],\n...                   [nan, 2.0, nan],\n...                   [4.0, nan, nan]])\n>>> QF.ffill(x, dim=0)\ntensor([[1., nan, 3.],\n        [1., 2., 3.],\n        [4., 2., 3.]])"

#: of qfeval_functions.functions.ffill.ffill:45
msgid ":func:`bfill`: Backward fill missing values."
msgstr ":func:`bfill`: 欠損値を後方補完する関数。"

#: of qfeval_functions.functions.ffill.ffill:46
msgid ":func:`fillna`: Replace NaN/infinity values with fixed numbers."
msgstr ":func:`fillna`: NaN や無限大を固定値で置き換える関数。"

