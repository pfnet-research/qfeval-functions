#: ../../api/qfeval_functions.functions.nancumprod.rst:2
msgid "nancumprod"
msgstr ""

#: of qfeval_functions.functions.nancumprod.nancumprod:1
msgid "Compute the cumulative product along a dimension, treating NaN as 1."
msgstr "指定された次元に沿って累積積を計算し、NaN を 1 として扱います。"

#: of qfeval_functions.functions.nancumprod.nancumprod:3
msgid ""
"This function calculates the cumulative product of elements along the "
"specified dimension, where NaN values are treated as 1 (multiplicative "
"identity) for the purpose of computing the cumulative product. However, "
"positions with NaN values in the original tensor remain NaN in the "
"output."
msgstr "この関数は、指定された次元に沿って要素の累積積を計算します。ここで、NaN 値は乗算の単位元である 1 として扱われます（累積積の計算目的のため）。ただし、元のテンソルで NaN 値を持つ位置は、出力でも NaN 値のままとなります。"

#: ../../api/qfeval_functions.functions.nancumprod.rst
msgid "Parameters"
msgstr "パラメータ"

#: of qfeval_functions.functions.nancumprod.nancumprod:9
msgid "The input tensor containing values."
msgstr "値を含む入力テンソル。"

#: of qfeval_functions.functions.nancumprod.nancumprod:12
msgid "The dimension along which to compute the cumulative product."
msgstr "累積積を計算する次元を指定します。"

#: ../../api/qfeval_functions.functions.nancumprod.rst
msgid "Returns"
msgstr "戻り値"

#: of qfeval_functions.functions.nancumprod.nancumprod:15
msgid ""
"A tensor of the same shape as the input, containing the cumulative "
"product values. Original NaN positions remain NaN."
msgstr "入力テンソルと同じ形状のテンソルで、累積積算値を格納します。元の NaN 位置はそのまま NaN として保持されます。"

#: ../../api/qfeval_functions.functions.nancumprod.rst
msgid "Return type"
msgstr "戻り値の型"

#: of qfeval_functions.functions.nancumprod.nancumprod:20
msgid "Example"
msgstr "使用例"

#: of qfeval_functions.functions.nancumprod.nancumprod:22
msgid ""
">>> # Simple cumulative product with NaN\n"
">>> x = torch.tensor([2.0, nan, 3.0, 4.0])\n"
">>> QF.nancumprod(x, dim=0)\n"
"tensor([ 2., nan,  6., 24.])"
msgstr ">>> # NaN を含む単純な累積積\n>>> x = torch.tensor([2.0, nan, 3.0, 4.0])\n>>> QF.nancumprod(x, dim=0)\ntensor([ 2., nan,  6., 24.])"

#: of qfeval_functions.functions.nancumprod.nancumprod:27
msgid ""
">>> # 2D tensor along columns\n"
">>> x = torch.tensor([[1.0, 2.0, nan, 4.0],\n"
"...                   [2.0, nan, 3.0, 5.0]])\n"
">>> QF.nancumprod(x, dim=1)\n"
"tensor([[ 1.,  2., nan,  8.],\n"
"        [ 2., nan,  6., 30.]])"
msgstr ">>> # 2 次元テンソルの列方向\n>>> x = torch.tensor([[1.0, 2.0, nan, 4.0],\n...                   [2.0, nan, 3.0, 5.0]])\n>>> QF.nancumprod(x, dim=1)\ntensor([[ 1.,  2., nan,  8.],\n        [ 2., nan,  6., 30.]])"

#: of qfeval_functions.functions.nancumprod.nancumprod:34
msgid ""
">>> # Cumulative product along rows\n"
">>> x = torch.tensor([[2.0, 3.0],\n"
"...                   [nan, 4.0],\n"
"...                   [5.0, 2.0]])\n"
">>> QF.nancumprod(x, dim=0)\n"
"tensor([[ 2.,  3.],\n"
"        [nan, 12.],\n"
"        [10., 24.]])"
msgstr ">>> # 行方向の累積積\n>>> x = torch.tensor([[2.0, 3.0],\n...                   [nan, 4.0],\n...                   [5.0, 2.0]])\n>>> QF.nancumprod(x, dim=0)\ntensor([[ 2.,  3.],\n        [nan, 12.],\n        [10., 24.]])"

#: of qfeval_functions.functions.nancumprod.nancumprod:43
msgid ""
">>> # Multiple NaNs\n"
">>> x = torch.tensor([1.0, nan, nan, 2.0, 3.0])\n"
">>> QF.nancumprod(x, dim=0)\n"
"tensor([1., nan, nan, 2., 6.])"
msgstr ">>> # 複数の NaN\n>>> x = torch.tensor([1.0, nan, nan, 2.0, 3.0])\n>>> QF.nancumprod(x, dim=0)\ntensor([1., nan, nan, 2., 6.])"

#: of qfeval_functions.functions.nancumprod.nancumprod:48
msgid ":func:`nancumsum`: NaN-aware cumulative sum."
msgstr ":func:`nancumsum`: NaN を考慮した累積和。"

#: of qfeval_functions.functions.nancumprod.nancumprod:49
msgid ":func:`torch.cumprod`: Standard cumulative product (NaN propagates)."
msgstr ":func:`torch.cumprod`: 標準の累積積算演算（NaN は伝播します）。"

#: of qfeval_functions.functions.nancumprod.nancumprod:50
msgid ":func:`torch.nan_to_num`: Convert NaN values to specified numbers."
msgstr ":func:`torch.nan_to_num`: NaN 値を指定した数値に変換します。"

