msgstr "安定ソートアルゴリズム: https://en.wikipedia.org/wiki/Sorting_algorithm#Stability"

#: of qfeval_functions.functions.stable_sort.stable_sort:115
msgid "Financial data ranking: https://en.wikipedia.org/wiki/Ranking#Finance"
msgstr "金融データのランキング手法: https://en.wikipedia.org/wiki/Ranking#Finance"

